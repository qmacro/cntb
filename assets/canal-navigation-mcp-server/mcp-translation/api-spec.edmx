        <Property Name="registrationNumber" Type="Edm.String" MaxLength="50"/>
        <NavigationProperty Name="status" Type="CanalNavigationService.VesselStatuses">
          <ReferentialConstraint Property="status_name" ReferencedProperty="name"/>
        </NavigationProperty>
        <Property Name="status_name" Type="Edm.String" MaxLength="50"/>
        <NavigationProperty Name="journeys" Type="Collection(CanalNavigationService.Journeys)" Partner="vessel">
          <OnDelete Action="Cascade"/>
        </NavigationProperty>
        <Property Name="statusName" Type="Edm.String"/>
      </EntityType>
      <EntityType Name="VesselStatuses">
        <Key>
          <PropertyRef Name="name"/>
