        </NavigationProperty>
        <Property Name="lock_ID" Type="Edm.Guid"/>
        <Property Name="waterwayName" Type="Edm.String"/>
        <Property Name="lockName" Type="Edm.String"/>
      </EntityType>
      <EntityType Name="Waterways">
        <Key>
