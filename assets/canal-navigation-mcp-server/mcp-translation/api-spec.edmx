        <Property Name="actualDeparture" Type="Edm.DateTimeOffset"/>
        <Property Name="scheduledArrival" Type="Edm.DateTimeOffset"/>
        <Property Name="actualArrival" Type="Edm.DateTimeOffset"/>
        <NavigationProperty Name="status" Type="CanalNavigationService.JourneyStatuses">
          <ReferentialConstraint Property="status_name" ReferencedProperty="name"/>
        </NavigationProperty>
        <Property Name="status_name" Type="Edm.String" MaxLength="50"/>
        <Property Name="notes" Type="Edm.String" MaxLength="1000"/>
        <NavigationProperty Name="lockPassages" Type="Collection(CanalNavigationService.LockPassages)" Partner="journey">
