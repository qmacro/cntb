  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
    <edmx:Include Alias="UI" Namespace="com.sap.vocabularies.UI.v1"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="CanalNavigationService" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <Annotation Term="Core.Links">
        <Collection>
          <Record>
            <PropertyValue Property="rel" String="author"/>
            <PropertyValue Property="href" String="https://cap.cloud.sap"/>
          </Record>
        </Collection>
      </Annotation>
      <EntityContainer Name="EntityContainer">
        <EntitySet Name="Vessels" EntityType="CanalNavigationService.Vessels">
          <NavigationPropertyBinding Path="status" Target="VesselStatuses"/>
          <NavigationPropertyBinding Path="journeys" Target="Journeys"/>
        </EntitySet>
        <EntitySet Name="VesselStatuses" EntityType="CanalNavigationService.VesselStatuses">
          <NavigationPropertyBinding Path="texts" Target="VesselStatuses_texts"/>
          <NavigationPropertyBinding Path="localized" Target="VesselStatuses_texts"/>
        </EntitySet>
        <EntitySet Name="Journeys" EntityType="CanalNavigationService.Journeys">
          <NavigationPropertyBinding Path="vessel" Target="Vessels"/>
          <NavigationPropertyBinding Path="route" Target="Routes"/>
          <NavigationPropertyBinding Path="status" Target="JourneyStatuses"/>
          <NavigationPropertyBinding Path="lockPassages" Target="LockPassages"/>
          <NavigationPropertyBinding Path="positionEvents" Target="PositionEvents"/>
        </EntitySet>
        <EntitySet Name="Routes" EntityType="CanalNavigationService.Routes">
          <NavigationPropertyBinding Path="segments" Target="RouteSegments"/>
        </EntitySet>
        <EntitySet Name="RouteSegments" EntityType="CanalNavigationService.RouteSegments">
          <NavigationPropertyBinding Path="route" Target="Routes"/>
          <NavigationPropertyBinding Path="waterway" Target="Waterways"/>
          <NavigationPropertyBinding Path="lock" Target="Locks"/>
        </EntitySet>
        <EntitySet Name="Waterways" EntityType="CanalNavigationService.Waterways">
          <NavigationPropertyBinding Path="locks" Target="Locks"/>
        </EntitySet>
        <EntitySet Name="Locks" EntityType="CanalNavigationService.Locks">
          <NavigationPropertyBinding Path="waterway" Target="Waterways"/>
          <NavigationPropertyBinding Path="status" Target="LockStatuses"/>
        </EntitySet>
        <EntitySet Name="LockStatuses" EntityType="CanalNavigationService.LockStatuses">
          <NavigationPropertyBinding Path="texts" Target="LockStatuses_texts"/>
          <NavigationPropertyBinding Path="localized" Target="LockStatuses_texts"/>
        </EntitySet>
        <EntitySet Name="JourneyStatuses" EntityType="CanalNavigationService.JourneyStatuses">
          <NavigationPropertyBinding Path="texts" Target="JourneyStatuses_texts"/>
          <NavigationPropertyBinding Path="localized" Target="JourneyStatuses_texts"/>
        </EntitySet>
        <EntitySet Name="LockPassages" EntityType="CanalNavigationService.LockPassages">
          <NavigationPropertyBinding Path="journey" Target="Journeys"/>
          <NavigationPropertyBinding Path="lock" Target="Locks"/>
          <NavigationPropertyBinding Path="status" Target="PassageStatuses"/>
        </EntitySet>
        <EntitySet Name="PassageStatuses" EntityType="CanalNavigationService.PassageStatuses">
          <NavigationPropertyBinding Path="texts" Target="PassageStatuses_texts"/>
          <NavigationPropertyBinding Path="localized" Target="PassageStatuses_texts"/>
        </EntitySet>
        <EntitySet Name="PositionEvents" EntityType="CanalNavigationService.PositionEvents">
          <NavigationPropertyBinding Path="journey" Target="Journeys"/>
        </EntitySet>
        <EntitySet Name="VesselStatuses_texts" EntityType="CanalNavigationService.VesselStatuses_texts"/>
        <EntitySet Name="LockStatuses_texts" EntityType="CanalNavigationService.LockStatuses_texts"/>
        <EntitySet Name="JourneyStatuses_texts" EntityType="CanalNavigationService.JourneyStatuses_texts"/>
        <EntitySet Name="PassageStatuses_texts" EntityType="CanalNavigationService.PassageStatuses_texts"/>
        <ActionImport Name="recordPosition" Action="CanalNavigationService.recordPosition" EntitySet="PositionEvents"/>
      </EntityContainer>
      <EntityType Name="Vessels">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="createdBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="modifiedAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="modifiedBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="name" Type="Edm.String" MaxLength="100" Nullable="false"/>
        <Property Name="type" Type="Edm.String" MaxLength="50"/>
        <Property Name="lengthMeters" Type="Edm.Decimal" Precision="6" Scale="2"/>
        <Property Name="widthMeters" Type="Edm.Decimal" Precision="5" Scale="2"/>
        <Property Name="draftMeters" Type="Edm.Decimal" Precision="4" Scale="2"/>
