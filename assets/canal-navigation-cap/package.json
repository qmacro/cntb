{
  "name": "canal-navigation-cap",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@cap-js/mcp": "^1.4.1",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^3",
    "c8": "^12.0.0"
  },
  "scripts": {
    "start": "cds-serve",
    "build": "npm run build --workspace=app/react-ui && cds build --production",
    "test": "sh ./scripts/run-tests.sh"
  },
  "private": true,
  "cds": {
    "mcp": {
      "per_action_tool": true
    },
    "[development]": {
      "requires": {
        "auth": "dummy"
      }
    },
    "[production]": {
      "folders": {
        "app": "app/react-ui/dist"
      }
    }
  },
  "workspaces": [
    "app/react-ui"
  ]
}
